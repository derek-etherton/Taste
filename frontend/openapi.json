  "/me/shelf-scans": {
   "post": {
    "summary": "Scan Shelf",
    "description": "Read a shelf photo and return its books, ranked for the user; it becomes their saved scan\n(GET /me/shelf-scan). At most TASTE_SHELF_SCANS_PER_HOUR an hour: each is a paid model call.\nIf the app hangs up first the scan still finishes and is saved.",
    "operationId": "scan_shelf_me_shelf_scans_post",
    "parameters": [
     {
      "name": "quality",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "maximum": 1,
       "minimum": 0,
       "description": "Weight on general quality; 0 = pure taste match",
       "default": 0.1,
       "title": "Quality"
      },
      "description": "Weight on general quality; 0 = pure taste match"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "multipart/form-data": {
       "schema": {
