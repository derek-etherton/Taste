{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["taste.api.app:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "taste",
      "runtimeExecutable": ".venv/Scripts/streamlit.exe",
      "runtimeArgs": ["run", "backend/taste/view/app.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501
    }
  ]
}
