# Copy to .env.local (gitignored). Expo bakes EXPO_PUBLIC_* into the app at build time.

# The API. On a phone, use the PC's LAN address: localhost is the phone itself.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Sign in with Google (README, Sign-in setup): the web client id, and on iOS the iOS client id and
# its URL scheme ("reversed client id"). Google's button stays hidden until these are set.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Local development only: sign in with any email (the API needs TASTE_DEV_LOGIN=true too).
# EXPO_PUBLIC_DEV_LOGIN=true

# iOS bundle id / Android package for native builds (Sign in with Apple is tied to it).
# TASTE_APP_ID=app.taste.books
