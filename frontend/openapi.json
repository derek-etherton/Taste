  "/profiles/{user}/{domain}/items": {
   "get": {
    "summary": "Items",
    "description": "For you: unrated items, best match first. Rate: what rating would teach the profile most.\nA search (q) covers the whole catalogue, rated items included. Each volume of a series is its own item.\nWith tags, the order is tag_match \u00d7 the item's percentile in the mode's own order: a soft AND,\nso what comes first both has the tags and is high on your list.",
    "operationId": "items_profiles__user___domain__items_get",
    "parameters": [
     {
      "name": "user",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$",
       "title": "User"
      }
     },
     {
      "name": "domain",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Domain"
      }
     },
     {
      "name": "mode",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "for_you",
        "rate"
       ],
       "type": "string",
       "default": "for_you",
       "title": "Mode"
      }
     },
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "",
       "title": "Q"
      }
     },
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "default": 1,
       "title": "Page"
      }
     },
     {
      "name": "page_size",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100,
       "minimum": 1,
       "default": 25,
       "title": "Page Size"
      }
     },
     {
      "name": "quality",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "maximum": 1,
       "minimum": 0,
       "description": "Weight on general quality; 0 = pure taste match",
       "default": 0.1,
       "title": "Quality"
      },
      "description": "Weight on general quality; 0 = pure taste match"
     },
     {
      "name": "tags",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "maxItems": 10,
       "default": [],
       "title": "Tags"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ItemPage"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
