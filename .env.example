TASTE_FILM_URL=
TASTE_BOOK_URL=
# Shelf scan reads spines with Claude when this is set (else the local Ollama model below).
# ANTHROPIC_API_KEY=
# TASTE_SHELF_MODEL=claude-sonnet-5-5
# TASTE_SHELF_EFFORT=medium
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
# The web app's origins (it signs in with a cookie, so never "*"). Default: ["http://localhost:8081"]
# CORS_ORIGINS=["https://taste.app"]

# Accounts (README, Accounts). The database (required):
TASTE_DATABASE_URL=postgresql+psycopg://taste@localhost:5432/taste
# Signs shelf-photo links: a long random value in production.
# TASTE_SECRET=
# Who may sign in: the iOS bundle id (Apple), and the Google web, iOS and Android client ids.
# TASTE_APPLE_CLIENT_IDS=["app.taste.books"]
# TASTE_GOOGLE_CLIENT_IDS=["...apps.googleusercontent.com"]
# Local development only: sign in as any email, no proof. Never in production.
# TASTE_DEV_LOGIN=true
# For dev.py: a folder with pg_ctl, to start the local Postgres in data/pg.
# TASTE_PG_BIN=D:/Tools/pgsql/bin
# Genomes (see backend/taste/model/genomes.py): BookGenome release folders to offer as book
# genomes, besides data/genomes/book/<name>/, and which genome each domain starts with.
# TASTE_BOOK_GENOME_PATHS=["D:/BookGenome/data/release/truegenome-2026-10-31"]
# TASTE_BOOK_GENOME=default
# TASTE_FILM_GENOME=default
# Open Library refresh (backend/scripts/openlibrary.py): a contact for its User-Agent, e.g. "you@example.com"
# TASTE_OPENLIBRARY_CONTACT=
